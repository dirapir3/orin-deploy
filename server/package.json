    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "multer": "^2.4.0",
    "pngjs": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
